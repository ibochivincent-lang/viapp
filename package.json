{
  "name": "viapp",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/contracts/stellar/bindings"
  ],
  "overrides": {
    "ws": "8.22.0"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "slice": "npm run slice --workspace=@viapp/core",
    "prove": "npm run prove --workspace=@viapp/core",
    "community:check": "node scripts/community-check.js",
    "viapp": "npm run viapp --workspace=@viapp/agent --"
  },
  "dependencies": {
    "viem": "^2.57.3"
  }
}
